---
interface PracticeFile {
  label: string;
  file: string;
  module?: number;
}

interface Props {
  files: PracticeFile[];
}

const { files } = Astro.props;

---

<ul class="practice-list">
  {files.map((f) => {
    const filename = f.file.split('/').pop() ?? f.file;
    return (
      <li class="practice-item">
        <div class="practice-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <div class="practice-info">
          <span class="practice-label">{f.label}</span>
          <span class="practice-filename">{filename}</span>
        </div>
        <a
          href={f.file}
          download
          class="btn btn-secondary btn-sm practice-dl"
          aria-label={`Download ${f.label}`}
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 2v8M5 7l3 3 3-3"/>
            <path d="M3 13h10"/>
          </svg>
          Download
        </a>
      </li>
    );
  })}
</ul>

<style>
  .practice-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .practice-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    transition: box-shadow 180ms ease;
  }
  .practice-item:hover { box-shadow: var(--shadow); }
  .practice-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--surface);
    color: var(--muted);
  }
  .practice-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .practice-label {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .practice-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .practice-dl { flex-shrink: 0; }
</style>
