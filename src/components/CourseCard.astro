---
interface Props {
  title: string;
  slug: string;
  tagline: string;
  duration: string;
  moduleCount: number;
  level: string;
  status: 'published' | 'coming-soon';
}

const { title, slug, tagline, duration, moduleCount, level, status } = Astro.props;
const isComingSoon = status === 'coming-soon';
const href = isComingSoon ? undefined : `/courses/${slug}`;
---

<article class:list={['course-card', 'card', { 'course-card--dim': isComingSoon }]}>
  <div class="course-card-accent"></div>
  <div class="course-card-body">
    {isComingSoon && <span class="badge badge-muted course-card-cs">Coming Soon</span>}
    <h3 class="course-card-title">{title}</h3>
    <p class="course-card-tagline">{tagline}</p>
    <div class="course-card-meta">
      <span class="badge">{level}</span>
      <span class="course-card-stat">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5"/></svg>
        {duration}
      </span>
      <span class="course-card-stat">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M5 7h6M5 10h4"/></svg>
        {moduleCount} modules
      </span>
    </div>
    {!isComingSoon && (
      <a href={href} class="btn btn-primary btn-sm course-card-cta">
        View Course
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    )}
  </div>
</article>

<style>
  .course-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }
  .course-card:not(.course-card--dim):hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(12,31,92,0.15);
  }
  .course-card--dim { opacity: 0.65; }
  .course-card-accent { height: 3px; flex-shrink: 0; background: var(--border); }
  .course-card-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .course-card-cs { align-self: flex-start; margin-bottom: 4px; }
  .course-card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.2;
  }
  .course-card-tagline {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
  }
  .course-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .course-card-stat {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
  }
  .course-card-cta { align-self: flex-start; margin-top: 8px; }
</style>
