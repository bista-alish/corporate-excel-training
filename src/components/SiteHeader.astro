---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-logo" aria-label="Home">
      <div class="site-logo-mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 4L10 16L16 4" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="site-logo-text">Corporate Excel Training</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/courses" class={pathname.startsWith('/courses') ? 'active' : ''}>Courses</a>
    </nav>
  </div>
</header>
