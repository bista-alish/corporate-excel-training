---
interface Module {
  n: number;
  name: string;
  summary: string;
  minutes: number;
}

interface Props {
  modules: Module[];
}

const { modules } = Astro.props;

---

<ol class="module-list">
  {modules.map((mod) => (
    <li class="module-item">
      <div class="module-num">
        {String(mod.n).padStart(2, '0')}
      </div>
      <div class="module-content">
        <div class="module-header">
          <h3 class="module-name">{mod.name}</h3>
          <span class="module-time">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5"/></svg>
            {mod.minutes} min
          </span>
        </div>
        <p class="module-summary">{mod.summary}</p>
      </div>
      <div class="module-bar"></div>
    </li>
  ))}
</ol>

<style>
  .module-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .module-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 20px 20px 16px;
    position: relative;
    overflow: hidden;
    transition: box-shadow 180ms ease;
  }
  .module-item:hover { box-shadow: var(--shadow); }
  .module-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--border);
  }
  .module-num {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: var(--surface);
    color: var(--muted);
  }
  .module-content { flex: 1; min-width: 0; }
  .module-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .module-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }
  .module-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .module-summary {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
  }
</style>
