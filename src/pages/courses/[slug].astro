---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModuleList from '../../components/ModuleList.astro';
import PracticeDownloads from '../../components/PracticeDownloads.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map(course => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

interface Props {
  course: CollectionEntry<'courses'>;
}

const { course } = Astro.props;
const { title, tagline, description, duration, moduleCount, level, modules, practiceFiles, deckPath } = course.data;

const totalMinutes = modules.reduce((sum, m) => sum + m.minutes, 0);
---

<BaseLayout title={`${title} — Vrit Jobs Training`} description={description}>

  <!-- ── Course hero ── -->
  <section class="course-hero">
    <div class="hero-accent-bar"></div>
    <div class="container course-hero-inner">
      <a href="/courses" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4l-4 4 4 4"/></svg>
        All Courses
      </a>
      <div class="course-hero-content">
        <div class="course-hero-text">
          <div class="course-badges">
            <span class="badge">{level}</span>
            <span class="badge">{moduleCount} modules</span>
            <span class="badge">{duration}</span>
          </div>
          <h1 class="course-title">{title}</h1>
          <p class="course-tagline">{tagline}</p>
          {deckPath && (
            <div class="course-hero-cta">
              <a href={`/courses/${course.slug}/deck`} class="btn btn-primary btn-lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Start Course
              </a>
              <span class="course-hero-meta">{totalMinutes} min total · {practiceFiles.length} practice files</span>
            </div>
          )}
        </div>
        <div class="course-hero-stats">
          {[
            { label: 'Duration', value: duration, icon: '⏱' },
            { label: 'Modules', value: String(moduleCount), icon: '📋' },
            { label: 'Level', value: level, icon: '📈' },
            { label: 'Practice files', value: String(practiceFiles.length), icon: '📥' },
          ].map(({ label, value, icon }) => (
            <div class="stat-box">
              <span class="stat-box-icon" aria-hidden="true">{icon}</span>
              <span class="stat-box-val">{value}</span>
              <span class="stat-box-lbl">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Body: modules + downloads ── -->
  <section class="section">
    <div class="container course-body">

      <div class="course-main">
        <!-- About -->
        <div class="course-section">
          <h2 class="course-section-title">About this course</h2>
          <p class="course-description">{description}</p>
        </div>

        <!-- Modules -->
        <div class="course-section">
          <h2 class="course-section-title">Course Modules</h2>
          <ModuleList modules={modules} />
        </div>
      </div>

      <aside class="course-sidebar">
        <!-- Start CTA -->
        {deckPath && (
          <div class="sidebar-card card sidebar-start">
            <h3 class="sidebar-card-title">Ready to start?</h3>
            <p class="sidebar-card-body">
              Launch the full interactive presentation in your browser. Use keyboard or touch to navigate.
            </p>
            <a href={`/courses/${course.slug}/deck`} class="btn btn-primary" style="width:100%; justify-content:center;">
              Launch Deck
            </a>
            <ul class="start-hints">
              <li>→ / Space — next slide</li>
              <li>← — previous slide</li>
              <li>R — reset to start</li>
              <li>1–9 — jump to slide</li>
            </ul>
          </div>
        )}

        <!-- Practice downloads -->
        {practiceFiles.length > 0 && (
          <div class="sidebar-card card">
            <h3 class="sidebar-card-title">Practice Files</h3>
            <p class="sidebar-card-body">Download the Excel workbooks to follow along during each module.</p>
            <PracticeDownloads files={practiceFiles} />
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .course-hero {
    background: var(--ink);
    position: relative;
    padding: 56px 0 64px;
  }
  .hero-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
  }
  .course-hero-inner { padding-top: 8px; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255,255,255,0.55);
    margin-bottom: 32px;
    transition: color 160ms;
  }
  .back-link:hover { color: rgba(255,255,255,0.9); }
  .course-hero-content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .course-hero-text { flex: 1; min-width: 0; }
  .course-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .course-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 800;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 14px;
  }
  .course-tagline {
    font-size: 19px;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 32px;
  }
  .course-hero-cta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .course-hero-meta { font-size: 14px; color: rgba(255,255,255,0.45); }
  .course-hero-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-self: flex-end;
  }
  .stat-box {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 90px;
    text-align: center;
  }
  .stat-box-icon { font-size: 20px; }
  .stat-box-val {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: #fff;
  }
  .stat-box-lbl { font-size: 12px; color: rgba(255,255,255,0.5); }

  /* ── Body ── */
  .course-body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 1024px) {
    .course-body { grid-template-columns: 1fr; }
    .course-sidebar { order: -1; }
  }
  .course-main { display: flex; flex-direction: column; gap: 48px; }
  .course-section { display: flex; flex-direction: column; gap: 20px; }
  .course-section-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    color: var(--ink);
  }
  .course-description {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.7;
  }

  /* ── Sidebar ── */
  .course-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 84px;
  }
  .sidebar-card { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .sidebar-start { border-top: 3px solid var(--accent); }
  .sidebar-card-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--ink);
  }
  .sidebar-card-body { font-size: 14px; color: var(--muted); line-height: 1.6; }
  .start-hints {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
